{
  "name": "geocoach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "dev": "pnpm build && pnpm start",
    "lint": "biome lint src scripts tests",
    "type-check": "tsc --noEmit",
		"test": "tsx --test tests/*.test.ts",
		"test:codex": "tsx tests/codex.live.ts"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "express": "^5.1.0",
    "marked": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@types/chrome": "^0.1.24",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "sharp"] }
}
